<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <rect width="512" height="512" fill="#161616"/>
  <!-- Outer Frame -->
  <rect x="32" y="32" width="448" height="448" fill="#262626" stroke="#393939" stroke-width="8"/>
  <!-- Carbon Blue Accent Core -->
  <rect x="96" y="96" width="320" height="320" fill="#161616" stroke="#0f62fe" stroke-width="12"/>
  <!-- Drafting Compass / Architectural Grid Lines -->
  <line x1="96" y1="96" x2="416" y2="416" stroke="#525252" stroke-width="4" stroke-dasharray="8 8"/>
  <line x1="416" y1="96" x2="96" y2="416" stroke="#525252" stroke-width="4" stroke-dasharray="8 8"/>
  <!-- Architectural Cross Symbol & Solid Blocks -->
  <rect x="196" y="196" width="120" height="120" fill="#0f62fe"/>
  <rect x="236" y="140" width="40" height="232" fill="#ffffff"/>
  <rect x="140" y="236" width="232" height="40" fill="#ffffff"/>
  <!-- Corner Measurement Markers -->
  <rect x="108" y="108" width="16" height="16" fill="#0f62fe"/>
  <rect x="388" y="108" width="16" height="16" fill="#0f62fe"/>
  <rect x="108" y="388" width="16" height="16" fill="#0f62fe"/>
  <rect x="388" y="388" width="16" height="16" fill="#0f62fe"/>
</svg>
